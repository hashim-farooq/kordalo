# Copy to .env and fill in. NEVER commit .env - it holds every secret.
# Use PERSONAL emails/accounts only (not work accounts).

# Kordalo release to run (a git tag / image tag from GitHub Releases).
KORDALO_VERSION=v1.0.0

# Main Kordalo domain. Its DNS A record must point at the server IP.
PRIMARY_DOMAIN=app.kordalo.com
# Every domain Caddy should serve, space-separated inside quotes. add-site.sh appends to this.
SITE_DOMAINS="app.kordalo.com"
# Personal email for Let's Encrypt certificate expiry notices.
ACME_EMAIL=you@example.com

# Leave blank: deploy.sh generates strong values on first run. SAVE THEM in a password manager.
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=

# MariaDB memory. 1G suits a 4 GB server; use 3G on 8 GB.
DB_BUFFER_POOL=1G

# ---- Off-site backups (restic, encrypted) ----
# Backblaze B2 (S3 API) example: s3:https://s3.us-west-004.backblazeb2.com/your-bucket-name
RESTIC_REPOSITORY=
# Leave blank: generated on first run. LOSE THIS = LOSE YOUR BACKUPS. Store it safely.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: healthchecks.io ping URL - alerts you if a nightly backup does not succeed.
HEALTHCHECK_URL=
