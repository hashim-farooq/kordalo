#: kordalo/accounts/doctype/payment_gateway_account/payment_gateway_account.json
msgid "<pre><h5>Message Example</h5>\n\n"
"&lt;p&gt; Thank You for being a part of {{ doc.company }}! We hope you are enjoying the service.&lt;/p&gt;\n\n"
"&lt;p&gt; Please find enclosed the E Bill statement. The outstanding amount is {{ doc.grand_total }}.&lt;/p&gt;\n\n"
"&lt;p&gt; We don't want you to be spending time running around in order to pay for your Bill.<br>After all, life is beautiful and the time you have in hand should be spent to enjoy it!<br>So here are our little ways to help you get more time for life! &lt;/p&gt;\n\n"
"&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n\n"
"</pre>\n"
msgstr "<pre><h5>Esempio di messaggio</h5>\\n\\n&lt;p&gt; La ringraziamo per far parte di {{ doc.company }}! Speriamo che stia apprezzando il servizio.&lt;/p&gt;\\n\\n&lt;p&gt; In allegato trova l'estratto conto E-Bill. L'importo insoluto è {{ doc.grand_total }}.&lt;/p&gt;\\n\\n&lt;p&gt; Non vogliamo che perda tempo a correre per pagare la sua fattura.<br>Dopotutto la vita è bella, e il tempo a disposizione va speso per godersela!<br>Ecco quindi alcuni piccoli modi per aiutarla a guadagnare più tempo per la vita! &lt;/p&gt;\\n\\n&lt;a href=\\\"{{ payment_url }}\\\"&gt; clicchi qui per pagare &lt;/a&gt;\\n\\n</pre>\\n"

#. Content of the 'Message Examples' (HTML) field in DocType 'Payment Request'
#: kordalo/accounts/doctype/payment_request/payment_request.json
msgid "<pre><h5>Message Example</h5>\n\n"
"&lt;p&gt;Dear {{ doc.contact_person }},&lt;/p&gt;\n\n"
"&lt;p&gt;Requesting payment for {{ doc.doctype }}, {{ doc.name }} for {{ doc.grand_total }}.&lt;/p&gt;\n\n"
"&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n\n"
"</pre>\n"
msgstr "<pre><h5>Esempio di messaggio</h5>\n\n"
"&lt;p&gt;Gentile {{ doc.contact_person }},&lt;/p&gt;\n\n"
"&lt;p&gt;Richiesta di pagamento per {{ doc.doctype }}, {{ doc.name }} per {{ doc.grand_total }}.&lt;/p&gt;\n\n"
"&lt;a href=\"{{ payment_url }}\"&gt; clicca qui per pagare &lt;/a&gt;\n\n"
"</pre>\n"

