#: kordalo/stock/doctype/serial_and_batch_bundle/serial_and_batch_bundle.py:1866
#, python-brace-format
msgid "\n"
"\t\t\tThe Batch {0} of an item {1} has negative stock in the warehouse {2}{3}.\n"
"\t\t\tPlease add a stock quantity of {4} to proceed with this entry.\n"
"\t\t\tIf it is not possible to make an adjustment entry, please enable 'Allow Negative Stock for Batch' in the batch {0} or in the Stock Settings to proceed.\n"
"\t\t\tHowever, enabling this setting may lead to negative stock in the system.\n"
"\t\t\tSo please ensure the stock levels are adjusted as soon as possible to maintain the correct valuation rate."
msgstr "\n"
"\t\t\tO Lote {0} do item {1} tem stock negativo no armazém {2}{3}.\n"
"\t\t\tPor favor, adicione uma quantidade de stock de {4} para prosseguir com este lançamento.\n"
"\t\t\tSe não for possível efetuar um lançamento de ajuste, ative 'Permitir stock negativo' no lote {0} ou nas Definições de stock para prosseguir.\n"
"\t\t\tNo entanto, ativar esta definição pode levar a stock negativo no sistema.\n"
"\t\t\tPor isso, certifique-se de que os níveis de stock são ajustados o mais rapidamente possível para manter a taxa de avaliação correta."

